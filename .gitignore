# Dependencies
node_modules/
**/node_modules/

# Build artifacts (never commit)
dist/
**/dist/
build/
**/build/
dev-dist/
**/dev-dist/
*.tsbuildinfo

# Environment files & secrets (never commit)
.env
.env.*
.env*.local
!.env.example
!.env.*.example
apps/*/.env
apps/*/.env.*
!apps/*/.env.example
!apps/*/.env.*.example

# Certificates & private keys (never commit)
*.pem
*.key
*.crt
*.cert
*.pfx
*.p12

# Local authentication tokens & credentials (never commit)
.auth/
**/.auth/
*.token
*.token.json
auth-*.json

# pnpm store
.pnpm-store
**/.pnpm-store

# Expo generated native folders (should only exist inside apps/mobile/, never at repo root)
/android
/ios
/app.json

# Keep VS Code workspace settings
!.vscode/settings.json
!.vscode/extensions.json
