# API Environment Variables
DATABASE_URL=postgresql://user:password@localhost:5432/goaltracker
PORT=3000
APP_VERSION=1.0.0

# HTTPS Configuration (Optional)
USE_HTTPS=false
SSL_CERT_PATH=/certs/cert.crt
SSL_KEY_PATH=/certs/cert.key

# Auth0 Authentication Configuration
# Get these from: https://manage.auth0.com/ -> Applications -> APIs
AUTH0_ISSUER=https://your-tenant.auth0.com/
AUTH0_AUDIENCE=https://api.goaltracker.com

# Auth0 Client IDs for legacy scope bypass validation (fail-closed)
# For Docker production deployments, set these in the server's Compose .env.
# AUTH0_WEB_CLIENT_ID also falls back to VITE_AUTH0_CLIENT_ID in Compose.
AUTH0_WEB_CLIENT_ID=your_web_client_id_here
AUTH0_MOBILE_CLIENT_ID=your_mobile_client_id_here
AUTH0_LEGACY_CLIENT_IDS=client_id_1,client_id_2
