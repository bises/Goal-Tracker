# Goal Tracker MCP Server Environment Variables

# Profile: development | production (default: production)
GOAL_TRACKER_PROFILE=production

# Production API URL (over Tailscale on jbhouse, port 3001)
GOAL_TRACKER_PROD_API_URL=https://100.115.237.63:3001

# Development API URL (local testing)
GOAL_TRACKER_DEV_API_URL=http://localhost:3000

# Auth0 Configuration
AUTH0_DOMAIN=bises.auth0.com

# Production Native Application Client ID (from Auth0 dashboard)
AUTH0_CLIENT_ID=your_native_client_id_here
AUTH0_AUDIENCE=https://goal-tracker-api

# Development Native Application Client ID (optional if testing against dev API)
AUTH0_DEV_CLIENT_ID=your_dev_client_id_here
AUTH0_DEV_AUDIENCE=https://goal-tracker-api-dev
